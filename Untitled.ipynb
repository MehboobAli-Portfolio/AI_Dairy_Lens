        "def predict_disease_smart(image_path, model_path='model.pth'):\n",
        "    # Make sure this list matches PyTorch's alphabetical sorting of your folders!\n",
        "    classes = ['Healthy', 'FMD', 'Lumpy Skin', 'Mastitis', 'not_cow']\n",
        "\n",
        "    if not os.path.exists(model_path):\n",
        "        print(f\"Error: Model not found at {model_path}\")\n",
        "        return\n",
        "\n",
        "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "    model = CattleCNN(num_classes=5)\n",
        "    model.load_state_dict(torch.load(model_path, map_location=device, weights_only=True))\n",
        "    model.to(device)\n",
        "    model.eval()\n",
        "\n",
        "\n",
        "    transform = transforms.Compose([\n",
        "        transforms.Resize(130),\n",
        "        transforms.CenterCrop(128),\n",
        "        transforms.ToTensor(),\n",
        "        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
        "    ])\n",
        "\n",
        "    try:\n",
        "        image = Image.open(image_path).convert('RGB')\n",
        "    except Exception as e:\n",
        "        print(f\"Error loading image: {e}\")\n",
        "        return\n",
        "\n",
        "    image_tensor = transform(image).unsqueeze(0).to(device)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model(image_tensor)\n",
        "        probabilities = torch.nn.functional.softmax(outputs[0], dim=0)\n",
        "\n",
        "    print(\"\\n\" + \"="*45)\n",
        "    print(f\"🩺 DIAGNOSIS REPORT: {os.path.basename(image_path)}\")\n",
        "    print(\"="*45)\n",
        "\n",
        "    # Find what the AI thinks is the absolute highest probability\n",
        "    top_score, top_idx = torch.max(probabilities, dim=0)\n",
        "    top_disease = classes[top_idx.item()]\n",
        "\n",
        "\n",
        "    # STEP 1: SAFETY CHECK (Is it even a cow?)\n",
        "    if top_disease == \"not_cow\":\n",
        "        print(f\"🚨 UNRECOGNIZED IMAGE! (Confidence: {top_score.item()*100:.2f}%)\")\n",
        "        print(\"This does not appear to be a cow. Please upload a valid image.\")\n",
        "\n",
        "\n",
        "    # STEP 2: IT IS A COW! Check for multiple diseases\n",
        "\n",
        "    else:\n",
        "        detected_issues = []\n",
        "        for i, cls in enumerate(classes):\n",
        "            # Skip the 'not_cow' class in this loop so it doesn't print as a disease\n",
        "            if cls == \"not_cow\":\n",
        "                continue\n",
        "\n",
        "            score = probabilities[i].item()\n",
        "            # If the AI suspects a disease is more than 15% likely, add it\n",
        "            if score >= 0.15:\n",
        "                detected_issues.append((cls, score))\n",
        "\n",
        "        # Sort them so the highest percentage is at the top\n",
        "        detected_issues.sort(key=lambda x: x[1], reverse=True)\n",
        "\n",
        "        print(\"Conditions Detected:\")\n",
        "        for issue in detected_issues:\n",
        "            if issue[0] == \"Healthy\" and issue[1] > 0.50:\n",
        "                print(f\"  ✅ {issue[0]} (Confidence: {issue[1]*100:.2f}%) - The cow appears fine.\")\n",
        "            else:\n",
        "                print(f\"  ⚠️ {issue[0]} (Confidence: {issue[1]*100:.2f}%)\")\n",
        "\n",
        "    # Print the raw background scores for debugging\n",
        "    print(\"\\n(Raw Background Scores):\")\n",
        "    for i, cls in enumerate(classes):\n",
        "        print(f\"  - {cls}: {probabilities[i].item() * 100:.2f}%\")"
      ]
    },
